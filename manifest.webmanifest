{
  "name": "Packliste",
  "short_name": "Packliste",
  "description": "Was ist schon im Koffer? Unsere Packliste für den Urlaub",
  "lang": "de",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#FFF7EC",
  "theme_color": "#FFF7EC",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" },
    { "src": "icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "share_target": {
    "action": "./teilen-empfangen",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "datei", "accept": ["text/plain", ".txt", "application/json", ".json"] }]
    }
  }
}
